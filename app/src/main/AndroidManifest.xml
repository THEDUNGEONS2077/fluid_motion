<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: fluid_motion: the app (its preview and settings) and
  the five live wallpapers, each its own service so the phone's picker
  lists all five. No permissions: nothing here goes online or reads data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live wallpapers and OpenGL ES 3.0: the store hides the app from phones without them. -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.FluidMotion">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".wallpaper.MatrixRainService"
            android:exported="true"
            android:label="@string/rain_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_rain" />
        </service>

        <service
            android:name=".wallpaper.NeuralNetService"
            android:exported="true"
            android:label="@string/neural_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_neural" />
        </service>

        <service
            android:name=".wallpaper.VelocityService"
            android:exported="true"
            android:label="@string/velocity_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_velocity" />
        </service>

        <service
            android:name=".wallpaper.DataFlowService"
            android:exported="true"
            android:label="@string/flow_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_flow" />
        </service>

        <service
            android:name=".wallpaper.MegacityService"
            android:exported="true"
            android:label="@string/megacity_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_megacity" />
        </service>

        <service
            android:name=".wallpaper.HorizonService"
            android:exported="true"
            android:label="@string/horizon_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_horizon" />
        </service>

        <service
            android:name=".wallpaper.SunsetService"
            android:exported="true"
            android:label="@string/sunset_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_sunset" />
        </service>
    </application>
</manifest>
