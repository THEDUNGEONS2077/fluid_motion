<?xml version="1.0" encoding="utf-8"?>
<!--
  themes.xml: the window before Compose draws: black, no action bar, no
  splash flash of white (the platform theme only: no Material library).
-->
<resources>
    <style name="Theme.FluidMotion" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
